# Public canonical origin, without a trailing slash. Confirm before production.
NEXT_PUBLIC_SITE_URL=

# Public, token-free Sanity configuration. Leave the project ID blank until a
# real project is authorised; the frontend will skip CMS requests safely.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-20

# Sanity Studio connection. These may match the public values above, but use
# Studio-prefixed names so the editing workspace has an explicit configuration.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
