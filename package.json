{
  "name": "ayo-omotoso-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "studio:dev": "node scripts/run-sanity.mjs dev",
    "sanity:check": "node scripts/run-sanity.mjs schemas validate --level warning",
    "sanity:schema": "node scripts/run-sanity.mjs schemas extract --path schema.json --enforce-required-fields --force",
    "sanity:types": "node scripts/run-sanity.mjs typegen generate",
    "sanity:validate": "npm run sanity:check && npm run sanity:schema && npm run sanity:types",
    "sanity:seed": "node scripts/run-sanity.mjs exec ../scripts/seed-sanity-foundation.ts --with-user-token",
    "sanity:seed:commit": "node scripts/run-sanity.mjs exec ../scripts/seed-sanity-foundation.ts --with-user-token -- --commit"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@sanity/client": "8.2.0",
    "@sanity/image-url": "2.1.1",
    "groq": "6.10.1",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "sanity": "6.10.1",
    "styled-components": "6.5.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@vercel/frameworks": {
      "js-yaml": "3.15.1",
      "smol-toml": "1.6.1"
    },
    "typeid-js": {
      "uuid": "11.1.1"
    }
  }
}
